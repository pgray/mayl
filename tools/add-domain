#!/usr/bin/env bash
# Register a sending domain and get its API token
# Usage: ./tools/add-domain example.com
set -e

export MAYL_ADDR=${MAYL_ADDR:-localhost}
export MAYL_PORT=${MAYL_PORT:-8080}

domain="${1:?Usage: ./tools/add-domain <domain>}"

curl -s -X POST http://${MAYL_ADDR}:${MAYL_PORT}/domains \
  -H "Content-Type: application/json" \
  -d "{\"domain\":\"$domain\"}" \
  | python3 -m json.tool 2>/dev/null || cat
echo
