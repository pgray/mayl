#!/bin/sh

# Clean up stale lock files from previous runs
rm -f /root/.cache/protonmail/bridge-v3/bridge-v3-gui.lock
rm -f /root/.cache/protonmail/bridge-v3/bridge-v3.lock

# Source dbus session address written by entrypoint
[ -f /run/dbus-session-env ] && . /run/dbus-session-env

# Run the bridge backend directly (not bridge-gui which needs Qt)
# --parent-pid -1 disables parent monitoring so it stays alive under runit
exec /usr/lib/protonmail/bridge/bridge --grpc --parent-pid -1
